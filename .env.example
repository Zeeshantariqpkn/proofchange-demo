# ============================================================
# ProofChange — Local configuration
# ============================================================

# --- AI mode -------------------------------------------------
# "documented_bob_workflow" = automated engine + documented prompts (default)
# "runtime_llm"            = call a live API for test generation
AI_MODE=runtime_llm

# --- IBM Bob / OpenAI-compatible provider --------------------
# Point this at whichever endpoint serves your Bob model.
# The adapter POSTs to: <AI_PROVIDER_BASE_URL>/chat/completions
AI_PROVIDER_BASE_URL=https://your-bob-endpoint.example.com/v1
AI_PROVIDER_API_KEY=sk-your-real-key-here
AI_MODEL=ibm-bob-2.0